#!/bin/sh
# Fetch-style display for TAMU Linux 1.0D and its original Bash 1.13.

user=`whoami`
host=`hostname`
kernel=`uname -sr`
arch=`uname -m`
# On Linux 1.0, awk cannot read these proc files directly; cat can.
mem=`cat /proc/meminfo | awk 'NR == 2 { printf "%.1f / %.1f MiB", $3 / 1048576, $2 / 1048576 }'`
disk=`df -k / | awk 'NR == 2 { printf "%.0f / %.0f MiB", $3 / 1024, $2 / 1024 }'`
uptime=`cat /proc/uptime | awk '{ hours = int($1 / 3600); mins = int(($1 % 3600) / 60); printf "%dh %dm", hours, mins }'`

maroon=''
white=''
reset=''
if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
    maroon=`printf '\033[1;31m'`
    white=`printf '\033[1;37m'`
    reset=`printf '\033[0m'`
fi

# Original seven-row ASCII TAMU logo; no university artwork is embedded.
printf '\n'
printf '  %s%s%s    %s%s@%s%s\n' "$maroon" '#######   ###   ##   ## ##   ##' "$reset" "$white" "$user" "$host" "$reset"
printf '  %s%s%s    %s--------------------------%s\n' "$maroon" '  ###    ## ##  ### ### ##   ##' "$reset" "$maroon" "$reset"
printf '  %s%s%s    %sOS:%s TAMU Linux 1.0D\n' "$maroon" '  ###   ##   ## ####### ##   ##' "$reset" "$maroon" "$reset"
printf '  %s%s%s    %sKernel:%s %s\n' "$maroon" '  ###   ####### ## # ## ##   ##' "$reset" "$maroon" "$reset" "$kernel"
printf '  %s%s%s    %sArch:%s %s\n' "$maroon" '  ###   ##   ## ##   ## ##   ##' "$reset" "$maroon" "$reset" "$arch"
printf '  %s%s%s    %sMemory:%s %s\n' "$maroon" '  ###   ##   ## ##   ##  ## ## ' "$reset" "$maroon" "$reset" "$mem"
printf '  %s%s%s    %sDisk:%s %s\n' "$maroon" '  ###   ##   ## ##   ##   ###  ' "$reset" "$maroon" "$reset" "$disk"
printf '  %s%-31s%s    %sUptime:%s %s\n' "$maroon" 'TEXAS A&M  /  LINUX 1.0D' "$reset" "$maroon" "$reset" "$uptime"
if [ -t 1 ] && [ -z "$NO_COLOR" ]; then
    printf '  %s%-31s%s    ' "$maroon" '=========================' "$reset"
    printf '\033[40m   \033[41m   \033[42m   \033[43m   \033[44m   \033[45m   \033[46m   \033[47m   \033[0m\n'
fi
printf '\n'
